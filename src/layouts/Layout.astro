---
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Inbind',
  description = 'Take notes the way AI likes to read them. A context-first writing tool for founders and small teams who create content with AI.',
} = Astro.props;

const pageTitle = title === 'Inbind' ? title : `${title} — Inbind`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="mk-page">
    <slot />
  </div>
</body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/marketing.css';
</style>
