---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CmdBlock from '../components/CmdBlock.astro';

let version = '0.1.21';
try {
  const res = await fetch('https://api.github.com/repos/inbindapp/inbind/releases/latest');
  if (res.ok) {
    const { tag_name } = await res.json();
    if (tag_name) version = tag_name.replace(/^v/, '');
  }
} catch {}
const base = `https://github.com/inbindapp/inbind/releases/download/v${version}`;

const platforms = [
  {
    name: 'macOS',
    meta: 'macOS 11 Big Sur or later',
    options: [
      { label: 'Apple Silicon (M-series)', arch: '.dmg · arm64', href: `${base}/Inbind_${version}_aarch64.dmg`, asset: 'Inbind_{v}_aarch64.dmg' },
      { label: 'Intel', arch: '.dmg · x86_64', href: `${base}/Inbind_${version}_x86_64.dmg`, asset: 'Inbind_{v}_x86_64.dmg' },
    ],
  },
  {
    name: 'Windows',
    meta: 'Windows 10 / 11',
    options: [
      { label: 'Installer', arch: '.msi · x64', href: `${base}/Inbind_${version}_x64_en-US.msi`, asset: 'Inbind_{v}_x64_en-US.msi' },
      { label: 'Setup', arch: '.exe · x64', href: `${base}/Inbind_${version}_x64-setup.exe`, asset: 'Inbind_{v}_x64-setup.exe' },
    ],
  },
  {
    name: 'Linux',
    meta: 'Ubuntu, Debian, Fedora, Arch',
    options: [
      { label: 'AppImage', arch: '.AppImage · amd64', href: `${base}/Inbind_${version}_amd64.AppImage`, asset: 'Inbind_{v}_amd64.AppImage' },
      { label: 'Debian / Ubuntu', arch: '.deb · amd64', href: `${base}/Inbind_${version}_amd64.deb`, asset: 'Inbind_{v}_amd64.deb' },
      { label: 'Fedora / RHEL', arch: '.rpm · x86_64', href: `${base}/Inbind-${version}-1.x86_64.rpm`, asset: 'Inbind-{v}-1.x86_64.rpm' },
    ],
  },
];
---

<Layout title="Download" description="Download Inbind for macOS, Windows, and Linux. Free to download and use." ogImage="/og/download.png">
  <Header />

  <section class="mk-section mk-section--download">
    <div class="mk-container">
      <div class="mk-section-head">
        <div class="mk-section-eyebrow" id="version-label">Download — version {version}</div>
        <h2 class="mk-section-h">Pick your computer.</h2>
        <p class="mk-section-sub">Inbind is free to download and use.</p>
      </div>

      <div class="mk-platforms">
        {platforms.map((p) => (
          <div class="mk-platform">
            <div class="mk-platform-header">
              <div>
                <h3>{p.name}</h3>
                <div class="mk-platform-meta">{p.meta}</div>
              </div>
            </div>
            <div class="mk-platform-options">
              {p.options.map((o) => (
                <a href={o.href} data-asset={o.asset} class="mk-platform-option">
                  <span>{o.label}</span>
                  <span class="arch">{o.arch}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mk-notice">
        <h3>One thing about the macOS build</h3>
        <p>
          The app isn't notarized yet. macOS will block it on first launch. Run this command in Terminal after installing to fix it. Or use <a href="https://itsalin.com/appInfo/?id=sentinel" target="_blank" rel="noopener noreferrer">Sentinel</a> if you'd rather skip the command line.
        </p>
        <CmdBlock command='xattr -cr "/Applications/Inbind.app"' />
      </div>

      <div class="mk-download-actions">
        <a href="https://github.com/inbindapp/inbind/releases" target="_blank" rel="noopener" class="mk-btn mk-btn--ghost">
          Older versions and changelog →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  (async () => {
    try {
      const res = await fetch('https://api.github.com/repos/inbindapp/inbind/releases/latest');
      if (!res.ok) return;
      const { tag_name } = await res.json();
      if (!tag_name) return;

      const version = tag_name.replace(/^v/, '');
      const base = `https://github.com/inbindapp/inbind/releases/download/${tag_name}`;

      document.querySelectorAll<HTMLAnchorElement>('[data-asset]').forEach((el) => {
        const asset = el.dataset.asset!.replace('{v}', version);
        el.href = `${base}/${asset}`;
      });

      const label = document.getElementById('version-label');
      if (label) label.textContent = `Download — version ${version}`;
    } catch {
      // silently fall back to the build-time version
    }
  })();
</script>
