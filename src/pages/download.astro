---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CmdBlock from '../components/CmdBlock.astro';

const version = '0.1.21';
const base = `https://github.com/inbindapp/inbind/releases/download/v${version}`;

const platforms = [
  {
    name: 'macOS',
    meta: 'macOS 11 Big Sur or later',
    options: [
      { label: 'Apple Silicon (M-series)', arch: '.dmg · arm64', href: `${base}/Inbind_${version}_aarch64.dmg` },
      { label: 'Intel', arch: '.dmg · x86_64', href: `${base}/Inbind_${version}_x86_64.dmg` },
    ],
  },
  {
    name: 'Windows',
    meta: 'Windows 10 / 11',
    options: [
      { label: 'Installer', arch: '.msi · x64', href: `${base}/Inbind_${version}_x64_en-US.msi` },
      { label: 'Setup', arch: '.exe · x64', href: `${base}/Inbind_${version}_x64-setup.exe` },
    ],
  },
  {
    name: 'Linux',
    meta: 'Ubuntu, Debian, Fedora, Arch',
    options: [
      { label: 'AppImage', arch: '.AppImage · amd64', href: `${base}/Inbind_${version}_amd64.AppImage` },
      { label: 'Debian / Ubuntu', arch: '.deb · amd64', href: `${base}/Inbind_${version}_amd64.deb` },
      { label: 'Fedora / RHEL', arch: '.rpm · x86_64', href: `${base}/Inbind-${version}-1.x86_64.rpm` },
    ],
  },
];
---

<Layout title="Download" description="Download Inbind for macOS, Windows, and Linux. Free to download and use.">
  <Header />

  <section class="mk-section mk-section--download">
    <div class="mk-container">
      <div class="mk-section-head">
        <div class="mk-section-eyebrow">Download — version {version}</div>
        <h2 class="mk-section-h">Pick your computer.</h2>
        <p class="mk-section-sub">Inbind is free to download and use.</p>
      </div>

      <div class="mk-platforms">
        {platforms.map((p) => (
          <div class="mk-platform">
            <div class="mk-platform-header">
              <div>
                <h3>{p.name}</h3>
                <div class="mk-platform-meta">{p.meta}</div>
              </div>
            </div>
            <div class="mk-platform-options">
              {p.options.map((o) => (
                <a href={o.href} class="mk-platform-option">
                  <span>{o.label}</span>
                  <span class="arch">{o.arch}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mk-notice">
        <h3>One thing about the macOS build</h3>
        <p>
          The app isn't notarized yet. macOS will block it on first launch. Run this command in Terminal after installing to fix it. Or use <a href="https://itsalin.com/appInfo/?id=sentinel" target="_blank" rel="noopener noreferrer">Sentinel</a> if you'd rather skip the command line.
        </p>
        <CmdBlock command='xattr -cr "/Applications/Inbind.app"' />
      </div>

      <div class="mk-download-actions">
        <a href="https://github.com/inbindapp/inbind/releases" target="_blank" rel="noopener" class="mk-btn mk-btn--ghost">
          Older versions and changelog →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
