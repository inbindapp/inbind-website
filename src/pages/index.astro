---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FlowLines from '../components/FlowLines.astro';
import FlowLinesZ from '../components/FlowLinesZ.astro';
import AppMock from '../components/AppMock.astro';
import { url } from '../utils/url';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Inbind',
  url: 'https://inbind.app',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS, Windows, Linux',
  description: 'A workspace where your AI starts from what your team actually knows. A free markdown editor with AI chat for macOS, Windows and Linux.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Inbind',
    url: 'https://inbind.app',
  },
};

const features = [
  {
    title: 'An editor that feels like a document',
    body: 'You see formatted text as you write, with tables, code blocks and to-do lists, instead of raw markdown. Link one page to another, drop images in where you need them, and add properties like status or type so you can find and filter your files later.',
    icon: '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>',
  },
  {
    title: 'AI that works like a teammate',
    body: 'The AI chat reads the files in your workspace and can search the web when it needs to. Leave it a comment on the page the way you would for a coworker. Every change it suggests shows up in the formatted page, and you accept or reject it before anything is applied.',
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8"/><path d="M8 13h5"/>',
  },
  {
    title: 'Bring your own AI',
    body: "Use the Claude or ChatGPT subscription you already pay for, so there's no second bill. You'll get each provider's newest capabilities as soon as they ship, and you can switch whenever you like.",
    icon: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>',
  },
  {
    title: 'Skills',
    body: "A skill is a saved way of doing a task: what to ask, what to read and what shape the result should take. The AI follows it every time, so you don't explain the same job twice. Skills you've already built for Claude or Codex work as they are, and you can create new ones by describing what you want in a short conversation.",
    icon: '<path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
  },
  {
    title: 'Connect your tools',
    body: "Connect the tools you already work in through MCP, and the AI can pull what it needs straight from them, so you're not copying and pasting into the chat.",
    icon: '<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/>',
  },
  {
    title: 'Work together on the same files',
    body: "Connect a GitHub account and your team works from the same up-to-date workspace, with comments on the page and every change kept in the history. Inbind handles the git side, so you don't need to know much about git, and your work stays backed up as plain markdown files you own.",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];

const alternatives = [
  {
    name: 'Google Docs and Microsoft Word',
    body: "Great editors with a legacy, and they come with the office suite most teams already use. The AI assistant was added on top of them later, so it isn't shaped by reviewed, current context about your product and customers.",
  },
  {
    name: 'Notion and Confluence',
    body: 'A shared place for your team\'s knowledge, with AI added on top. Notion only includes AI in its more expensive plans and charges credits for heavier use, and the pages go stale unless someone keeps them up to date by hand.',
  },
  {
    name: 'ChatGPT and Claude apps',
    body: "The chat is great. Their memory and projects hold a slice of your context, but it's flat, your team can't review it, and it stays with one vendor.",
  },
  {
    name: 'A setup you built yourself',
    body: 'An Obsidian vault, VS Code with Claude Code, or an "AI brain" in Claude can cover everything, but it\'s a setup to maintain rather than a place to work. Keeping it current means re-uploading files and rewriting instructions by hand.',
  },
];
---


<Layout title="Inbind" description="A workspace where your AI starts from what your team actually knows. A free markdown editor with AI chat for macOS, Windows and Linux." ogImage="/og/home.png" schema={schema}>
  <Header />

  <!-- HERO -->
  <section class="mk-hero">
    <div class="mk-container">
      <div style="max-width: 780px;">
        <div class="mk-eyebrow">A context-first workspace</div>
        <h1 class="mk-h1">Your AI is only as good as the context you give it.</h1>
        <p class="mk-lead">
          Inbind keeps your notes, docs and drafts where the AI can read them, so a blog post, product doc or customer update starts from what you actually know instead of guessing.
        </p>
        <div class="mk-hero-ctas">
          <div class="mk-hero-ctas__buttons">
            <a class="mk-btn mk-btn--primary mk-btn--lg" href={url('download')}>Download Inbind</a>
          </div>
          <span class="mk-hero-meta">
            Free for macOS, Windows and Linux. Works with the Claude or ChatGPT subscription you already have.
          </span>
        </div>
      </div>

      <!-- HERO COMPOSITION: product mock with flow lines -->
      <div class="mk-hero-frame">
        <div style="position: relative;">
          <FlowLinesZ
            count={4}
            style="position: absolute; top: -80px; left: -80px; width: calc(100% + 160px); height: calc(100% + 160px); pointer-events: none;"
            opacity={0.35}
          />
          <div class="mk-hero-mock" style="position: relative; z-index: 2;">
            <AppMock />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="mk-audience">
    <div class="mk-container mk-audience-grid">
      <div>
        <div class="mk-section-eyebrow">For AI-native GTM teams</div>
        <h2 class="mk-section-h">Made for people who write with AI every week.</h2>
      </div>
      <div class="mk-audience-body">
        <div class="mk-role-chips" aria-hidden="true">
          <span class="mk-role-chip">Marketing</span>
          <span class="mk-role-chip">Sales</span>
          <span class="mk-role-chip">Product</span>
          <span class="mk-role-chip">Customer success</span>
        </div>
        <p>Inbind is for people in marketing, sales, product and customer success who use AI to produce market-facing work. If your drafts keep coming out generic because the AI doesn't know what's true about your product and customers right now, this is the problem we built Inbind to fix.</p>
        <a class="mk-arrow-link" href={url('use-cases')}>See how people use it <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="mk-section mk-band">
    <div class="mk-container">
      <div class="mk-section-head">
        <div class="mk-section-eyebrow">What you get</div>
        <h2 class="mk-section-h">Write with AI and see exactly what it changes.</h2>
        <p class="mk-section-sub">Inbind works on plain markdown files in a folder on your computer. Everything here comes with the free download, and there are no plugins to set up first.</p>
      </div>
      <div class="mk-features">
        {features.map((f) => (
          <div class="mk-feature">
            <div class="mk-feature-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="mk-section">
    <div class="mk-container">
      <div class="mk-section-head">
        <div class="mk-section-eyebrow">Honest comparison</div>
        <h2 class="mk-section-h">How Inbind compares to what you use today.</h2>
        <p class="mk-section-sub">Most people weigh Inbind against an editor they already have, an AI chat app, or a setup they built themselves. Each of those covers part of the job well.</p>
      </div>
      <div class="mk-alt-grid">
        {alternatives.map((alt) => (
          <div class="mk-alt-card">
            <h3>{alt.name}</h3>
            <p>{alt.body}</p>
          </div>
        ))}
        <div class="mk-alt-self">
          <img src={url('favicon.svg')} alt="" width="52" height="52" />
          <div>
            <h3>Inbind</h3>
            <p>The AI chat, an editor made for writing and your skills all work on the same files, and every change the AI suggests shows up in the formatted page before it lands. It uses the AI subscription you already have.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="mk-cta">
    <div class="mk-cta-flow-tl"><FlowLines count={4} withAnchor={false} /></div>
    <div class="mk-cta-flow-br"><FlowLines count={4} withAnchor={false} /></div>
    <div class="mk-container mk-cta-inner">
      <h2>Try it on your own files.</h2>
      <p>Inbind is free, and there's no Inbind account to create. Download it, open a folder, and connect the Claude or ChatGPT subscription you already have.</p>
      <a class="mk-btn mk-btn--primary mk-btn--lg" href={url('download')}>Download Inbind</a>
    </div>
  </section>

  <Footer />
</Layout>
