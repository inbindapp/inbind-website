---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FlowLines from '../components/FlowLines.astro';
import FlowLinesZ from '../components/FlowLinesZ.astro';
import AppMock from '../components/AppMock.astro';
import { url } from '../utils/url';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Inbind',
  url: 'https://inbind.app',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS, Windows, Linux',
  description: 'A local-first markdown editor with built-in AI chat. Write, store context, and generate content in one window.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Inbind',
    url: 'https://inbind.app',
  },
};
---

<Layout title="Inbind — Markdown editor with AI chat" description="A local-first markdown editor with built-in AI chat. For people already using AI and markdown who are tired of juggling four tools to get one draft out." ogImage="/og/home.png" schema={schema}>
  <Header />

  <!-- HERO -->
  <section class="mk-hero">
    <div class="mk-container">
      <div style="max-width: 760px;">
        <div class="mk-eyebrow">A context-first writing tool</div>
        <h1 class="mk-h1">Take notes the way AI likes to read them.</h1>
        <p class="mk-lead">
          Inbind is a writing tool for people who already use AI and markdown but are tired of juggling a notes app, a code editor, version control, and an AI chat just to get a decent draft out.<span style="display: block; margin-top: 12px;">Notes, context, and editor in one place. So the AI actually has something real to work with.</span>
        </p>
        <div class="mk-hero-ctas">
          <div class="mk-hero-ctas__buttons">
            <a class="mk-btn mk-btn--primary mk-btn--lg" href={url('download')}>Download Inbind</a>
          </div>
          <span class="mk-hero-meta">
            Free download for macOS, Windows & Linux.
          </span>
        </div>
      </div>

      <!-- HERO COMPOSITION — Product mock with flow lines -->
      <div class="mk-hero-frame">
        <div style="position: relative;">
          <FlowLinesZ
            count={4}
            style="position: absolute; top: -80px; left: -80px; width: calc(100% + 160px); height: calc(100% + 160px); pointer-events: none;"
            opacity={0.35}
          />
<div style="position: relative; z-index: 2;">
            <AppMock />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="mk-section" style="background: var(--bg-panel); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="mk-container">
      <div class="mk-section-head">
        <div class="mk-section-eyebrow">What you get</div>
        <h2 class="mk-section-h">Built for the way you actually write.</h2>
        <p class="mk-section-sub">Everything works out of the box. No plugins, no configuration. Your files stay on your computer as plain Markdown.</p>
      </div>
      <div class="mk-features">
        <div class="mk-feature">
          <div class="mk-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          </div>
          <h3>Real-time Markdown editor</h3>
          <p>Write in markdown and see formatted output instantly. Select text to change formatting. No preview toggle, no raw syntax on screen.</p>
        </div>
        <div class="mk-feature">
          <div class="mk-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6l2.1 2.1M5.6 18.4l2.1-2.1m8.6-8.6l2.1-2.1"/>
            </svg>
          </div>
          <h3>AI chat that reads your files</h3>
          <p>A built-in chat panel (Claude or Codex) that reads everything in your workspace. Ask it to summarize a doc, draft from your notes, or rewrite in your voice.</p>
        </div>
        <div class="mk-feature">
          <div class="mk-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 11 12 14 22 4"/>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
          </div>
          <h3>Visual AI edit approval</h3>
          <p>Changes proposed by the AI are shown as a visual diff before they're applied. Review and approve edits in one click. No raw markdown diffs.</p>
        </div>
        <div class="mk-feature">
          <div class="mk-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="9" y1="13" x2="15" y2="13"/>
              <line x1="9" y1="17" x2="13" y2="17"/>
            </svg>
          </div>
          <h3>Local-first Markdown</h3>
          <p>Your notes are <code>.md</code> files in a folder you choose. Open them in any other editor whenever you want.</p>
        </div>
        <div class="mk-feature">
          <div class="mk-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
          </div>
          <h3>Page properties</h3>
          <p>Add metadata to any file. Status, tags, content type, whatever makes sense. No raw YAML required.</p>
        </div>
        <div class="mk-feature">
          <div class="mk-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
          </div>
          <h3>Wiki links and inline assets</h3>
          <p>Type <code>[[</code> to link any note. Drag in screenshots and see them inline. The agent follows links the way you do.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="mk-section">
    <div class="mk-container">
      <div class="mk-section-head">
        <div class="mk-section-eyebrow">Honest comparison</div>
        <h2 class="mk-section-h">How Inbind is different.</h2>
        <p class="mk-section-sub">If your writing workflow involves three or four apps before you even start drafting, you know the pain. Inbind puts all of that in one window.</p>
      </div>
      <div class="mk-compare">
        <table>
          <thead>
            <tr>
              <th>What you want</th>
              <th class="is-self">Inbind</th>
              <th>ChatGPT</th>
              <th>Notion AI</th>
              <th>Obsidian</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Real-time formatted editing</td>
              <td class="is-self"><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell">Partially</span></td>
            </tr>
            <tr>
              <td>AI edits shown before they apply</td>
              <td class="is-self"><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell">N/A</span></td>
            </tr>
            <tr>
              <td>AI agent reads your folder</td>
              <td class="is-self"><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell">Scoped to chat</span></td>
              <td><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell">Third-party</span></td>
            </tr>
            <tr>
              <td>Plain Markdown on your computer</td>
              <td class="is-self"><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
            </tr>
            <tr>
              <td>Works out of the box, no plugins</td>
              <td class="is-self"><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell">N/A</span></td>
              <td><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
            </tr>
            <tr>
              <td>File metadata without raw YAML</td>
              <td class="is-self"><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell">Partially</span></td>
            </tr>
            <tr>
              <td>Works offline</td>
              <td class="is-self"><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell mk-compare-no">— No</span></td>
              <td><span class="mk-compare-cell mk-compare-yes">✓ Yes</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="mk-cta">
    <div class="mk-cta-flow-tl"><FlowLines count={4} withAnchor={false} /></div>
    <div class="mk-cta-flow-br"><FlowLines count={4} withAnchor={false} /></div>
    <div class="mk-container mk-cta-inner">
      <h2>Try it. It's free.</h2>
      <p>No account. No upload. Just download and point it at a folder.</p>
      <a class="mk-btn mk-btn--primary mk-btn--lg" href={url('download')}>Download Inbind</a>
    </div>
  </section>

  <Footer />
</Layout>
