---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FlowLines from '../components/FlowLines.astro';
import UseCaseIllustration from '../components/UseCaseIllustration.astro';
import { url } from '../utils/url';

type IllusKind = 'scattered' | 'voice' | 'messaging' | 'docs' | 'client';

interface UseCase {
  illus: IllusKind;
  title: string;
  problem: string;
  solution: string;
  link?: { label: string; href: string };
}

const contentMarketing = { label: 'Inbind for content marketing', href: url('use-cases/content-marketing') };

const useCases: UseCase[] = [
  {
    illus: 'voice',
    title: 'Founder building thought leadership',
    problem:
      "You've got expertise worth sharing, but it's spread across meeting notes, product updates and your own head, and you're supposed to show up on social, on your blog and maybe in audio or video too. Every AI draft you try sounds like it could have come from anyone.",
    solution:
      'You capture your thinking as notes, keep your product and brand material in the same workspace, and turn it into pieces for each channel from there. The AI works from what you actually know, so what you publish reads like it came from someone who knows the product and the industry, and it takes less of your time.',
    link: contentMarketing,
  },
  {
    illus: 'scattered',
    title: 'Content manager',
    problem:
      "You're the one who makes sure content goes out regularly, but you're not always the expert on the topic. You rely on teammates to feed you input, and the AI drafts you get need heavy editing before they sound on-brand.",
    solution:
      "Your teammates' input lands in the workspace as notes, next to your brand and product docs, and the AI drafts from all of it. First drafts come out closer to publishable, and the content stays consistent even when the expertise comes from several people.",
    link: contentMarketing,
  },
  {
    illus: 'messaging',
    title: 'Product marketing manager',
    problem:
      'You own the messaging everyone else builds on: positioning, product facts, and the collateral that goes with them. Keeping it right means gathering input from business area leads, structuring it, checking it back with them, and then handing it to sales and marketing, who brief their own AI tools from their own copies until the story drifts.',
    solution:
      'Your messaging framework and product facts live in the workspace, and new input from stakeholders arrives as notes that update them through changes you review. One-pagers and sales material are drafted from that same source, so every piece makes the same claims, and the people you hand off to can produce their own material from it without rewriting the story.',
  },
  {
    illus: 'docs',
    title: 'Engineer who owns the docs',
    problem:
      'You keep notes on what was built and why, but turning them into polished documentation or release notes is a separate job that keeps getting pushed back.',
    solution:
      "You keep implementation notes in Inbind and generate feature docs or release notes from them when you're ready to publish. The result reflects what was actually built, not what someone remembered weeks later.",
  },
  {
    illus: 'client',
    title: 'Customer success manager',
    problem:
      'Customer context like onboarding history, pain points and past incidents is spread across notes and email threads, so writing anything client-facing means hunting through all of it first.',
    solution:
      "You keep that context in Inbind and have the AI draft tailored guides, incident summaries or status updates from it. What you send is specific and accurate, and you didn't have to go digging for it.",
  },
];

const notFit = [
  {
    bold: 'You only write now and then.',
    rest: "The AI gets more useful as your notes and docs build up in the workspace, so Inbind won't do much for you as a one-off writing tool.",
  },
  {
    bold: "You'd rather write without AI.",
    rest: 'Inbind is built around working with an AI, so a plain markdown editor will suit you better.',
  },
  {
    bold: 'You need a CMS or a publishing pipeline.',
    rest: "Inbind is where the writing happens, not where content gets scheduled and published, so if your team already has content ops in place, it won't replace them.",
  },
];
---

<Layout
  title="Use cases"
  description="How founders, content managers, product marketing managers, engineers and customer success managers use Inbind to turn their notes into work that sounds like them."
  ogImage="/og/use-cases.png"
>
  <Header />

  <!-- PAGE HEADER -->
  <section class="mk-page-head">
    <div class="mk-container">
      <div class="mk-section-head">
        <div class="mk-section-eyebrow">Who it's for</div>
        <h1 class="mk-section-h">
          You already use AI to write. <br />You just wish the output didn't need so much fixing.
        </h1>
        <p class="mk-section-sub">
          Inbind is for people who produce market-facing work with AI and keep getting drafts that sound like everyone else's, because the AI doesn't know what's true about their product and customers right now.
        </p>
      </div>
    </div>
  </section>

  <!-- USE CASES: editorial alternating layout -->
  <section class="mk-section mk-band">
    <div class="mk-container">
      <div class="mk-uc-list">
        {useCases.map((uc, i) => (
          <article class={`mk-uc-card${i % 2 === 1 ? ' is-flipped' : ''}`}>
            <div class="mk-uc-illus">
              <UseCaseIllustration kind={uc.illus} />
            </div>
            <div class="mk-uc-body">
              <div class="mk-uc-num">{String(i + 1).padStart(2, '0')}</div>
              <h2 class="mk-uc-title">{uc.title}</h2>
              <div class="mk-uc-cols">
                <div class="mk-uc-col mk-uc-col--problem">
                  <div class="mk-uc-label mk-uc-label--problem">
                    <span class="mk-uc-label-x">✕</span>
                    The friction
                  </div>
                  <p class="mk-uc-problem">{uc.problem}</p>
                </div>
                <div class="mk-uc-col mk-uc-col--solution">
                  <div class="mk-uc-label mk-uc-label--solution">
                    <span class="mk-uc-label-arrow">→</span>
                    With Inbind
                  </div>
                  <p class="mk-uc-solution">{uc.solution}</p>
                </div>
              </div>
              {uc.link && (
                <a class="mk-arrow-link mk-uc-link" href={uc.link.href}>{uc.link.label} <span aria-hidden="true">→</span></a>
              )}
            </div>
          </article>
        ))}
      </div>

      <!-- NOT A FIT -->
      <div class="mk-not-fit">
        <div class="mk-not-fit-head">
          <div class="mk-section-eyebrow">A quick reality check</div>
          <h2 class="mk-not-fit-title">When Inbind isn't the right tool.</h2>
        </div>
        <div class="mk-not-fit-grid">
          {notFit.map((item) => (
            <div class="mk-not-fit-tile">
              <div class="mk-uc-label mk-uc-label--problem">
                <span class="mk-uc-label-x">✕</span>
                Skip if
              </div>
              <p class="mk-not-fit-bold">{item.bold}</p>
              <p class="mk-not-fit-rest">{item.rest}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="mk-cta">
    <div class="mk-cta-flow-tl"><FlowLines count={4} withAnchor={false} /></div>
    <div class="mk-cta-flow-br"><FlowLines count={4} withAnchor={false} /></div>
    <div class="mk-container mk-cta-inner">
      <h2>See if it fits.</h2>
      <p>Download Inbind, open a folder, and try it on a piece of work you actually need to get done. There's no Inbind account to create.</p>
      <a class="mk-btn mk-btn--primary mk-btn--lg" href={url('download')}>Download Inbind</a>
    </div>
  </section>

  <Footer />
</Layout>
