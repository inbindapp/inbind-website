    <div class="mk-footer-grid">
      <div class="mk-footer-brand">
        <img src={url('logo-color.svg')} alt="Inbind" style="height: 22px;" />
        <p>Your context, kept current.</p>
      </div>
      <div class="mk-footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href={url('download')}>Download</a></li>
          <li><a href={url('use-cases')}>Use cases</a></li>
          <li><a href={url('use-cases/content-marketing')}>Content marketing</a></li>
          <li><a href={url('pricing')}>Pricing</a></li>
          <li><a href={url('privacy')}>Privacy &amp; security</a></li>
        </ul>
      </div>
      <div class="mk-footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href={url('about')}>About</a></li>
          <li><a href={url('blog')}>Blog</a></li>
        </ul>
      </div>
      <div class="mk-footer-col">
        <h4>Hello</h4>
        <ul>
          <li><a href="mailto:hey@inbind.app">hey@inbind.app</a></li>
