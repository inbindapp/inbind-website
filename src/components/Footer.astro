---
import { url } from '../utils/url';
---

<footer class="mk-footer">
  <div class="mk-container">
    <div class="mk-footer-grid">
      <div class="mk-footer-brand">
        <img src={url('logo-color.svg')} alt="Inbind" style="height: 22px;" />
        <p>Take notes the way AI likes to read them.</p>
      </div>
      <div class="mk-footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href={url('download')}>Download</a></li>
          <li><a href={url('use-cases')}>Use Cases</a></li>
          <li><a href={url('pricing')}>Pricing</a></li>
          <li><a href="https://github.com/inbindapp/inbind" target="_blank" rel="noopener">Source on GitHub</a></li>
        </ul>
      </div>
      <div class="mk-footer-col">
        <h4>Read</h4>
        <ul>
          <li><a href={url('blog')}>Blog</a></li>
          <li><a href="https://github.com/inbindapp/inbind/releases" target="_blank" rel="noopener">Changelog</a></li>
        </ul>
      </div>
      <div class="mk-footer-col">
        <h4>Hello</h4>
        <ul>
          <li><a href="https://github.com/inbindapp/inbind/issues" target="_blank" rel="noopener">Open an issue</a></li>
          <li><a href="mailto:hello@inbind.app">hello@inbind.app</a></li>
        </ul>
      </div>
    </div>
    <div class="mk-footer-bottom">
      <span>© 2026 Inbind. Made with sunshine.</span>
      <span>Open source, MIT licensed.</span>
    </div>
  </div>
</footer>
