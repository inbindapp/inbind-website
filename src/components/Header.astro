---
import { url, homeUrl } from '../utils/url';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function isActive(href: string) {
  const full = href === '/' ? (base || '/') : `${base}${href}`;
  if (href === '/') return path === full || path === `${full}/`;
  return path.startsWith(full);
}
---

<header class="mk-header">
  <div class="mk-container mk-header-inner">
    <a href={homeUrl} class="mk-logo">
      <img src={url('logo-color.svg')} alt="Inbind" width="80" height="26" />
    </a>
    <nav class="mk-nav" id="mk-nav">
      <a href={homeUrl} class:list={[{ active: isActive('/') }]}>Home</a>
      <div class="mk-nav-group">
        <a href={url('use-cases')} class:list={['mk-nav-parent', { active: isActive('/use-cases') }]}>
          Use cases
          <svg class="mk-nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </a>
        <div class="mk-nav-menu">
          <div class="mk-nav-menu-inner">
            <a href={url('use-cases/content-marketing')} class:list={['mk-nav-menu-item', { active: isActive('/use-cases/content-marketing') }]}>
              <span class="mk-nav-menu-title">Content marketing</span>
              <span class="mk-nav-menu-desc">Write with AI and still sound like yourself.</span>
            </a>
          </div>
        </div>
      </div>
      <a href={url('pricing')} class:list={[{ active: isActive('/pricing') }]}>Pricing</a>
      <a href={url('blog')} class:list={[{ active: isActive('/blog') }]}>Blog</a>
      <a href={url('about')} class:list={[{ active: isActive('/about') }]}>About</a>
    </nav>
    <div class="mk-header-cta">
      <a href={url('download')} class="mk-btn mk-btn--primary" style="height: 36px; font-size: 14px; padding: 0 14px;">Download</a>
    </div>
    <button class="mk-nav-toggle" id="mk-nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mk-nav">
      <span class="mk-nav-toggle__bar"></span>
      <span class="mk-nav-toggle__bar"></span>
      <span class="mk-nav-toggle__bar"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('mk-nav-toggle');
  const nav = document.getElementById('mk-nav');

  function setOpen(open: boolean) {
    nav?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    setOpen(!nav?.classList.contains('is-open'));
  });

  // Close when a link is tapped
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
