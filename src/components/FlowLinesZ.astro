---
interface Props {
  count?: number;
  class?: string;
  style?: string;
  opacity?: number;
}

const {
  count = 6,
  class: className = '',
  style = '',
  opacity = 1,
} = Astro.props;

const gradId = `zFlowGrad-${Math.random().toString(36).slice(2, 8)}`;

const W = 1400;
const H = 500;
const spread = 20;

// Z keypoints: horizontal at bottom, diagonal through center, horizontal at top
const diagStartX = W * 0.32;
const diagEndX = W * 0.68;
const diagWidth = diagEndX - diagStartX;
const bottomY = H * 0.72;
const topY = H * 0.28;

const lines = Array.from({ length: count }, (_, i) => {
  const t = i - (count - 1) / 2;
  const sy = bottomY + t * spread;
  const ey = topY + t * spread;
  const cb = diagWidth * 0.1; // corner blend radius

  const d = [
    `M 0 ${sy}`,
    `C ${diagStartX * 0.45} ${sy} ${diagStartX - cb} ${sy} ${diagStartX} ${sy}`,
    `C ${diagStartX + cb} ${sy} ${diagEndX - cb} ${ey} ${diagEndX} ${ey}`,
    `C ${diagEndX + cb} ${ey} ${W * 0.88} ${ey} ${W} ${ey}`,
  ].join(' ');

  return { d };
});
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  class={`mk-flow-z ${className}`}
  style={`opacity: ${opacity}; ${style}`}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0"    stop-color="#ffd93d" stop-opacity="0" />
      <stop offset="0.08" stop-color="#ffd93d" stop-opacity="1" />
      <stop offset="0.92" stop-color="#ff6b6b" stop-opacity="1" />
      <stop offset="1"    stop-color="#ff6b6b" stop-opacity="0" />
    </linearGradient>
  </defs>
  {lines.map(({ d }) => (
    <path
      d={d}
      stroke={`url(#${gradId})`}
      stroke-width="14"
      stroke-linecap="round"
      fill="none"
    />
  ))}
</svg>
