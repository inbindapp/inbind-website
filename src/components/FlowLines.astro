---
interface Props {
  count?: number;
  withAnchor?: boolean;
  mirror?: boolean;
  class?: string;
  style?: string;
  opacity?: number;
}

const {
  count = 5,
  withAnchor = true,
  mirror = false,
  class: className = '',
  style = '',
  opacity = 1,
} = Astro.props;

const gradId = `flowGrad-${Math.random().toString(36).slice(2, 8)}`;

const W = 600;
const H = 360;
const anchorX = 320;
const startX = 30;
const total = count;
const spread = 110;

const lines = Array.from({ length: count }, (_, i) => {
  const yEnd = H / 2 + (i - (total - 1) / 2) * 22;
  const yStart = H / 2 + (i - (total - 1) / 2) * (22 + spread / total);
  return {
    i,
    d: `M ${startX} ${yStart} C ${startX + 90} ${yStart}, ${anchorX - 80} ${yEnd}, ${anchorX - 18} ${yEnd}`,
  };
});
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class={`mk-flow ${className}`}
  style={`transform: ${mirror ? 'scaleX(-1)' : 'none'}; opacity: ${opacity}; ${style}`}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffd93d" />
      <stop offset="1" stop-color="#ff6b6b" />
    </linearGradient>
  </defs>
  {lines.map(({ d }) => (
    <path
      d={d}
      stroke={`url(#${gradId})`}
      stroke-width="14"
      stroke-linecap="round"
      fill="none"
    />
  ))}
  {withAnchor && (
    <rect
      x={anchorX - 12}
      y={H / 2 - 80}
      width="24"
      height="160"
      rx="12"
      fill="#2b2b2b"
    />
  )}
</svg>
