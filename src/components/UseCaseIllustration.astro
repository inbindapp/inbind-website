  {kind === "client" && (
    <>
      {clientSources.map((s, i) => (
        <g transform={`translate(${s.x} ${s.y})`}>
          <rect width={s.w} height="32" rx="16" fill={PAPER_HI} stroke={BORDER} stroke-width="1.2" />
          <circle cx="16" cy="16" r="6" fill={clientDotColors[i]} opacity="0.7" />
          <rect x="28" y="11" width={s.w - 40} height="2.4" rx="1.2" fill={INK} opacity="0.7" />
          <rect x="28" y="18" width={s.w - 52} height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        </g>
      ))}
      {clientFlows.map((d) => (
        <path d={d} stroke={`url(#${gradId})`} stroke-width={FLOW_STROKE} stroke-opacity={FLOW_OPACITY} stroke-linecap="round" fill="none" />
      ))}
      <rect x="324" y="62" width={ANCHOR_W} height="136" rx={ANCHOR_W / 2} fill={INK} opacity={INK_OPACITY} />
      <g transform="translate(354 54)">
        <path
          d="M 8 0 H 138 a 8 8 0 0 1 8 8 V 130 a 8 8 0 0 1 -8 8 H 38 L 22 154 V 138 H 8 a 8 8 0 0 1 -8 -8 V 8 a 8 8 0 0 1 8 -8 Z"
          fill={PAPER}
          stroke={INK}
          stroke-width="1.4"
        />
        <circle cx="22" cy="22" r="8" fill="#ff6b6b" />
        <rect x="36" y="17" width="60" height="3.6" rx="1.8" fill={INK} />
        <rect x="36" y="25" width="44" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="14" y="44" width="80" height="4" rx="2" fill={INK} />
        <rect x="14" y="58" width="116" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="14" y="66" width="108" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="14" y="74" width="112" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="14" y="82" width="90" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="14" y="98" width="100" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="14" y="106" width="86" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
