---
/**
 * Use-case illustrations. Five composed-from-the-same-DNA mini scenes
 * that share a flow-line motif:
 *
 *   - small scattered inputs on the left
 *   - brand-gradient flow strokes (7px, 78% opacity)
 *   - a slim dark anchor capsule (12px wide, 88% opacity)
 *   - a clean output document on the right
 *
 * Used inside .mk-uc-illus on the Use Cases page.
 */

interface Props {
  kind: "scattered" | "voice" | "raw" | "docs" | "client";
}
const { kind } = Astro.props;

const FLOW_STROKE = 7;
const FLOW_OPACITY = 0.78;
const INK = "#2b2b2b";
const INK_OPACITY = 0.88;
const ANCHOR_W = 12;
const PAPER = "#fffef9";
const PAPER_HI = "#faf8f4";
const BORDER = "#e5e0d5";
const INK_SOFT = "#7b746b";

// Each illustration has its own gradient id so multiple instances on
// the same page don't share defs.
const gradId = `il-${kind}-${Math.random().toString(36).slice(2, 8)}`;

/* ─── 1. Scattered ─────────────────────────────────────── */
const scatteredCards = [
  { x: 12,  y: 22,  r: -8 },
  { x: 48,  y: 84,  r:  6 },
  { x: 18,  y: 162, r: -4 },
  { x: 86,  y: 38,  r: 12 },
  { x: 80,  y: 142, r: -10 },
  { x: 122, y: 96,  r:  3 },
];
const scatteredFlows = [0, 1, 2, 3, 4].map((i) => {
  const yEnd = 130 + (i - 2) * 12;
  const yStart = 50 + i * 35;
  return `M 170 ${yStart} C 240 ${yStart}, 280 ${yEnd}, 330 ${yEnd}`;
});

/* ─── 2. Voice ─────────────────────────────────────────── */
const voiceDocs = [
  { x: 320, y: 22 },
  { x: 320, y: 86 },
  { x: 320, y: 150 },
];
const voiceFlows = voiceDocs.map((d, i) => {
  const yStart = 130 + (i - 1) * 24;
  const yEnd = d.y + 46;
  return `M 124 ${yStart} C 200 ${yStart}, 240 ${yEnd}, 310 ${yEnd}`;
});
const voiceWidths = [
  [36, 78, 70, 22, 90, 64, 78],
  [48, 92, 92, 22, 90, 84, 56],
  [28, 70, 70, 22, 90, 76, 84],
];

/* ─── 3. Raw notes ─────────────────────────────────────── */
const rawFlows = [0, 1, 2, 3].map((i) => {
  const yStart = 50 + i * 50;
  const yEnd = 110 + (i - 1.5) * 18;
  return `M 170 ${yStart} C 230 ${yStart}, 270 ${yEnd}, 320 ${yEnd}`;
});

/* ─── 4. Docs ──────────────────────────────────────────── */
const docsFlows = [0, 1, 2, 3].map((i) => {
  const yStart = 70 + i * 40;
  const yEnd = 110 + (i - 1.5) * 16;
  return `M 175 ${yStart} C 235 ${yStart}, 275 ${yEnd}, 325 ${yEnd}`;
});

/* ─── 5. Client comms ──────────────────────────────────── */
const clientSources = [
  { x: 14, y: 18,  w: 116 },
  { x: 26, y: 64,  w: 100 },
  { x: 14, y: 110, w: 116 },
  { x: 30, y: 156, w: 96  },
];
const clientDotColors = ["#ff6b6b", "#ffd93d", "#ff6b6b", "#ffd93d"];
const clientFlows = [0, 1, 2, 3].map((i) => {
  const yStart = 38 + i * 46;
  const yEnd = 120 + (i - 1.5) * 12;
  return `M 158 ${yStart} C 220 ${yStart}, 260 ${yEnd}, 320 ${yEnd}`;
});
---

<svg viewBox="0 0 460 260" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffd93d" />
      <stop offset="1" stop-color="#ff6b6b" />
    </linearGradient>
  </defs>

  {kind === "scattered" && (
    <>
      {scatteredCards.map((c) => (
        <g transform={`translate(${c.x} ${c.y}) rotate(${c.r})`}>
          <rect width="58" height="38" rx="4" fill={PAPER} stroke={BORDER} stroke-width="1.2" />
          <rect x="7" y="9"  width="34" height="2.6" rx="1.3" fill={INK_SOFT} opacity="0.55" />
          <rect x="7" y="16" width="44" height="2.6" rx="1.3" fill={INK_SOFT} opacity="0.35" />
          <rect x="7" y="23" width="22" height="2.6" rx="1.3" fill={INK_SOFT} opacity="0.35" />
        </g>
      ))}
      {scatteredFlows.map((d) => (
        <path d={d} stroke={`url(#${gradId})`} stroke-width={FLOW_STROKE} stroke-opacity={FLOW_OPACITY} stroke-linecap="round" fill="none" />
      ))}
      <rect x="334" y="58" width={ANCHOR_W} height="144" rx={ANCHOR_W / 2} fill={INK} opacity={INK_OPACITY} />
      <g transform="translate(370 60)">
        <rect width="78" height="140" rx="6" fill={PAPER} stroke={INK} stroke-width="1.4" />
        <rect x="10" y="14" width="44" height="5"  rx="2" fill={INK} />
        <rect x="10" y="28" width="58" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="10" y="36" width="54" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="10" y="44" width="40" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="10" y="60" width="36" height="3.6" rx="1.6" fill={INK} />
        <rect x="10" y="72" width="58" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="10" y="80" width="50" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="10" y="88" width="56" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="10" y="104" width="30" height="3.6" rx="1.6" fill={INK} />
        <rect x="10" y="116" width="48" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="10" y="124" width="44" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
      </g>
    </>
  )}

  {kind === "voice" && (
    <>
      <g transform="translate(20 60)">
        <rect width="86" height="140" rx="8" fill={PAPER} stroke={BORDER} stroke-width="1.4" />
        <rect x="12" y="14" width="46" height="5" rx="2" fill={INK} />
        <rect x="12" y="28" width="64" height="2.6" rx="1.3" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="36" width="58" height="2.6" rx="1.3" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="44" width="62" height="2.6" rx="1.3" fill={INK_SOFT} opacity="0.55" />
