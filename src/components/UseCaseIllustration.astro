        <rect x="14" y="46" width="22" height="3.4" rx="1.6" fill="#ff6b6b" />
        <rect x="40" y="46" width="80" height="3.4" rx="1.6" fill="#e5e7eb" opacity="0.55" />
        <rect x="22" y="58" width="92" height="3.4" rx="1.6" fill="#e5e7eb" opacity="0.55" />
        <rect x="22" y="70" width="56" height="3.4" rx="1.6" fill="#7dd3fc" opacity="0.7" />
        <rect x="82" y="70" width="42" height="3.4" rx="1.6" fill="#e5e7eb" opacity="0.55" />
        <rect x="22" y="82" width="74" height="3.4" rx="1.6" fill="#e5e7eb" opacity="0.55" />
        <rect x="14" y="94" width="28" height="3.4" rx="1.6" fill="#ff6b6b" />
        <rect x="46" y="94" width="60" height="3.4" rx="1.6" fill="#e5e7eb" opacity="0.55" />
        <rect x="22" y="106" width="50" height="3.4" rx="1.6" fill="#ffd93d" />
        <rect x="76" y="106" width="48" height="3.4" rx="1.6" fill="#e5e7eb" opacity="0.55" />
        <rect x="14" y="118" width="48" height="3.4" rx="1.6" fill="#e5e7eb" opacity="0.55" />
