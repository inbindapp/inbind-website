        <rect x="12" y="32" width="68" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="40" width="62" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="48" width="66" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="56" width="44" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="72" width="36" height="4" rx="1.8" fill={INK} />
        <rect x="18" y="86" width="60" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <circle cx="14" cy="87.5" r="1.4" fill="#ff6b6b" />
        <rect x="18" y="96" width="56" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <circle cx="14" cy="97.5" r="1.4" fill="#ff6b6b" />
        <rect x="18" y="106" width="64" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <circle cx="14" cy="107.5" r="1.4" fill="#ff6b6b" />
        <rect x="12" y="124" width="30" height="4" rx="1.8" fill={INK} />
        <rect x="12" y="138" width="66" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="146" width="58" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="154" width="64" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="162" width="40" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
      </g>
    </>
  )}

  {kind === "docs" && (
    <>
      <g transform="translate(20 50)">
        <rect width="146" height="160" rx="8" fill="#2e2e30" />
        <circle cx="14" cy="14" r="3.2" fill="#ff5f57" />
        <circle cx="24" cy="14" r="3.2" fill="#febc2e" />
        <circle cx="34" cy="14" r="3.2" fill="#28c840" />
        <rect x="14" y="34" width="40" height="3.4" rx="1.6" fill="#ffd93d" />
