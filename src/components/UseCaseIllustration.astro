        <rect x="12" y="154" width="58" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
        <rect x="12" y="162" width="44" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.55" />
      </g>
    </>
