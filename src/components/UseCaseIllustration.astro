          <rect x="10" y="52" width="22" height="3" rx="1.5" fill={INK} opacity="0.85" />
          <rect x="10" y="62" width="90" height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.5" />
          <rect x="10" y="70" width={voiceWidths[i][5]} height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.5" />
          <rect x="10" y="78" width={voiceWidths[i][6]} height="2.4" rx="1.2" fill={INK_SOFT} opacity="0.5" />
        </g>
      ))}
    </>
  )}

  {kind === "raw" && (
